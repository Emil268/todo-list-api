# ==============================
# APP CONFIGURATION
# ==============================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ==============================
# DATABASE
# ==============================
MONGO_URI=mongodb://127.0.0.1:27017/todo_list_db
MONGO_URI_TEST=mongodb://127.0.0.1:27017/todo_list_db_test

# ==============================
# JWT
# ==============================
JWT_SECRET=replace_this_with_a_very_long_random_secret_key
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_IN=1

# ==============================
# API KEY (Machine-to-Machine)
# ==============================
API_KEY=replace_this_with_a_random_static_api_key

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================
# BCRYPT
# ==============================
BCRYPT_SALT_ROUNDS=10
